# ─────────────────────────────────────────────────────────────────────────────
# URL Uploader Bot — Environment Variables Example
# Copy this file to `.env` (for local dev) or set the same keys in Render.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF...           # from @BotFather
API_ID=1234567                         # from https://my.telegram.org
API_HASH=abcdef1234567890abcdef1234567890
OWNER_ID=123456789                     # your Telegram user ID (numeric)
DATABASE_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
LOG_CHANNEL=-1001234567890            # private channel ID (negative number)

# ── Required for Mini App on Render ──────────────────────────────────────────
# Public URL of THIS deployment. Telegram needs an HTTPS URL for the WebApp button.
WEBAPP_URL=https://your-bot.onrender.com

# ── Optional ──────────────────────────────────────────────────────────────────
BOT_USERNAME=UrlUploaderBot
ADMIN=11111111 22222222               # space-separated extra admin user IDs
BANNED_USERS=                          # space-separated user IDs to block initially
UPDATES_CHANNEL=                       # updates channel username (without @)

# Pyrogram session string (premium account) — enables 4 GB uploads
SESSION_STRING=

# Cookies for yt-dlp (Instagram/Pinterest/etc.) — either file path OR inline data
COOKIES_FILE=cookies.txt
# COOKIES_DATA= Netscape-format cookies file content (newlines escaped as \n)

# Proxy for yt-dlp/aiohttp — supports http://, https://, socks5://
PROXY=

# Chunk size in KB (default 10240 = 10 MB)
CHUNK_SIZE=10240

# External API fallbacks (already have working defaults)
COBALT_API_URL=https://arrogant-karrah-akila-4c42ca1e.koyeb.app
LINK_API_URL=https://native-serene-maduranga11-43790d26.koyeb.app

# Bot behavior
ALLOW_BOT_URL_UPLOAD=True

# Adsgram monetization
ADSGRAM_BLOCK_ID=int-23574

# ── Render/PaaS deployment knobs ──────────────────────────────────────────────
# Render injects PORT automatically — only set this for local dev.
# PORT=8080

# Self-ping interval (seconds) to mitigate Render's 15-min inactivity sleep.
# Set to 0 to disable. Default: 600 (10 min).
KEEP_ALIVE_INTERVAL=600

# Optional heavy services — disabled by default to fit Render free tier (512 MB RAM).
# Set to "true" to enable (requires more RAM; may need Render paid plan).
ENABLE_PLAYWRIGHT=false
ENABLE_PO_TOKEN_SERVER=false
ENABLE_ARIA2=false

# Path to ffmpeg binary (usually just "ffmpeg" if installed system-wide)
FFMPEG_PATH=ffmpeg
